<!-- R05 (id 1905xx) — 서비스 계정의 sudo · 반복 실패 · 에이전트 끊김 -->
<group name="purple,purple_r05,">
  <rule id="190501" level="12">
    <if_sid>5401,5402</if_sid>
    <match type="pcre2">^(www-data|apache|nginx|node)\s+:</match>
    <description>PURPLE R05: 웹 서비스 계정 $(srcuser) 의 sudo 사용 — 권한상승 시도</description>
    <mitre><id>T1548.003</id></mitre>
    <group>attack,privilege_escalation,</group>
  </rule>
  <rule id="190502" level="10" frequency="3" timeframe="600">
    <if_matched_sid>5401</if_matched_sid>
    <same_srcuser />
    <description>PURPLE R05: 10분에 sudo 실패 3회 이상 $(srcuser)</description>
    <mitre><id>T1548.003</id></mitre>
  </rule>
  <rule id="190503" level="10">
    <if_sid>504</if_sid>
    <match type="pcre2">(juiceshop|neobank|govportal|mediforum)</match>
    <description>PURPLE R05: 대량 로그 서버 에이전트 연결 끊김 — 로그 공백(방어회피) 가능성</description>
    <mitre><id>T1562.001</id></mitre>
  </rule>
</group>
